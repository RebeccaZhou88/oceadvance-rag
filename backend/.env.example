# ===== Azure OpenAI =====
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
AZURE_OPENAI_API_KEY=                       # 建议设为系统环境变量 AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=               # 例如 gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ===== LLM (OpenAI 兼容接口: DeepSeek / DashScope / ...) =====
LLM_API_KEY=                                # 建议设为系统环境变量 LLM_API_KEY
LLM_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# Embedding model — 必须与 ingestion 时用的保持一致（同一个端点、同一个维度）
LLM_EMBEDDING_MODEL_NAME=text-embedding-v2
LLM_EMBEDDING_DIMENSIONS=1536

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_API_KEY=                       # 建议设为系统环境变量 AZURE_SEARCH_API_KEY
AZURE_SEARCH_INDEX_NAME=rag-index-v2
# 检索模式: vector（纯向量） | hybrid（BM25 + 向量 + RRF 融合）
# 中文知识库建议 vector（BM25 简单解析器分词粗糙），英文可试 hybrid 提高关键词命中率
AZURE_SEARCH_MODE=hybrid
# 重排策略: semantic | cross-encoder | llm | none
RERANK_STRATEGY=cross-encoder
# 召回与重排参数
HYBRID_TOP_K=10                             # Azure 召回候选池大小（RRF 融合后）
FINAL_TOP_K=3                               # 重排后最终给 LLM 的文档数
RRF_K=60                                    # RRF 融合参数

# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
USE_MOCK_BACKEND=false                      # true = 跳过 Azure，用内存模拟（本地调试）
HF_ENDPOINT=https://hf-mirror.com           # CrossEncoder 国内镜像
ENABLE_ONLINE_EVAL=true                     # true = 每次回答多一次 LLM 自评（~15-20s）

# 检索"有效文档"判定阈值（两套，对应两种检索模式）
# vector: Azure @search.score = (1+cos)/2，ada-002 各向异性使无关文本常达 0.75-0.80
RETRIEVAL_EFFECTIVE_THRESHOLD=0.82
# hybrid: RRF 融合分数量级 0.01-0.05
RETRIEVAL_EFFECTIVE_THRESHOLD_HYBRID=0.02

# ===== 可观测性 =====
PROMETHEUS_ENABLED=true
ALERT_P95_LATENCY_SECONDS=5
ALERT_DAILY_TOKEN_COST_USD=10
ALERT_HALLUCINATION_RATE=0.05

# ===== 质量治理（CrewAI，异步后台，可选） =====
GOVERNANCE_ENABLED=true
# GOVERNANCE_DB_PATH=                      # 留空默认 backend/data/governance/tasks.db
GOVERNANCE_MIN_FAITHFULNESS=3.5
GOVERNANCE_MIN_RELEVANCY=3.5
GOVERNANCE_MAX_HALLUCINATION=0.3
