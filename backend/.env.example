# ===== Azure OpenAI =====
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
AZURE_OPENAI_API_KEY=                       # recommended: set via system env var AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=               # e.g. gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ===== LLM (OpenAI-compatible endpoint: DeepSeek / DashScope / ...) =====
LLM_API_KEY=                                # recommended: set via system env var LLM_API_KEY
LLM_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# embedding model — must match ingestion (same endpoint, same dimensions)
LLM_EMBEDDING_MODEL_NAME=text-embedding-v2
LLM_EMBEDDING_DIMENSIONS=1536

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_API_KEY=                       # recommended: set via system env var AZURE_SEARCH_API_KEY
AZURE_SEARCH_INDEX_NAME=rag-index-v2
# search mode: vector (pure embedding) | hybrid (BM25 + Vector + RRF fusion)
# vector recommended for Chinese kb (BM25 simple parser tokenizes poorly); try hybrid for English keyword hits
AZURE_SEARCH_MODE=hybrid
# rerank strategy: semantic | cross-encoder | llm | none
RERANK_STRATEGY=cross-encoder
# recall & rerank parameters
HYBRID_TOP_K=10                             # Azure recall pool size (after RRF fusion)
FINAL_TOP_K=3                               # final doc count given to LLM after rerank
RRF_K=60                                    # RRF fusion parameter

# ===== App =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
USE_MOCK_BACKEND=false                      # true = skip Azure, in-memory mock (local debugging)
HF_ENDPOINT=https://hf-mirror.com           # CrossEncoder model mirror (China acceleration)
ENABLE_ONLINE_EVAL=true                     # true = one extra LLM self-check per answer (~15-20s)

# "effective doc" thresholds (two sets, one per search mode)
# vector: Azure @search.score = (1+cos)/2; ada-002 anisotropy pushes unrelated text to 0.75-0.80
RETRIEVAL_EFFECTIVE_THRESHOLD=0.82
# hybrid: RRF fusion score magnitude 0.01-0.05
RETRIEVAL_EFFECTIVE_THRESHOLD_HYBRID=0.02

# ===== Observability =====
PROMETHEUS_ENABLED=true
ALERT_P95_LATENCY_SECONDS=5
ALERT_DAILY_TOKEN_COST_USD=10
ALERT_HALLUCINATION_RATE=0.05

# ===== Quality governance (CrewAI, async background, optional) =====
GOVERNANCE_ENABLED=true
# GOVERNANCE_DB_PATH=                      # blank = default backend/data/governance/tasks.db
GOVERNANCE_MIN_FAITHFULNESS=3.5
GOVERNANCE_MIN_RELEVANCY=3.5
GOVERNANCE_MAX_HALLUCINATION=0.3
